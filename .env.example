# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this application is hosted.
APP_URL="MY_APP_URL"

# Server HTTP port (Render injects PORT automatically; defaults to 3000)
PORT="3000"

# Production Auth & Vault Encryption (optional locally; recommended on Render)
JWT_SECRET="CHANGE_ME_TO_A_64_CHAR_RANDOM_SECRET"
CONFIG_ENCRYPTION_KEY="CHANGE_ME_TO_A_32_BYTE_ENCRYPTION_KEY"

# Optional Remote PHP Vault Backup Bridge (for Render Free Tier ephemeral disk)
# Point to https://bihargraminbazaar.com/api/crm_vault.php and match $SECRET_TOKEN
BACKUP_SYNC_URL=""
BACKUP_SYNC_TOKEN=""
